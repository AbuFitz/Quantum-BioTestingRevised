---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TestCards from '../components/TestCards.astro';
import Journey from '../components/Journey.astro';
import Tips from '../components/Tips.astro';
import FaqSection from '../components/FaqSection.astro';
import CloseEnquiry from '../components/CloseEnquiry.astro';
import visit from '../assets/photos/visit.jpg';
import { SITE, PRICE, RRP } from '../data/site';
import { FAQS, INCLUDED } from '../data/tests';
import { COUNT } from '../data/clinics';
import LocationHub from '../components/LocationHub.astro';
import consult from '../assets/photos/consult.jpg';
import { faqLd } from '../data/seo';

const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, legalName: SITE.legalName, url: Astro.site!.href, logo: new URL('/icon-512.png', Astro.site).href };
const tips = [
  { icon: 'utensils-crossed', title: 'Fast for 8–12 hours', text: 'Water is fine, and encouraged. A morning appointment makes this easiest.' },
  { icon: 'pill', title: 'Carry on with medication', text: 'Take prescribed medication as usual, unless your doctor has told you otherwise.' },
  { icon: 'dumbbell', title: 'Go easy on exercise', text: 'Skip intense workouts for 24 hours beforehand, as they can affect some results.' },
];
---
<Base
  title="Private Blood Tests for Men and Women | Quantum BioTesting"
  description={`Private Men’s and Women’s Health Checks at ${PRICE} each (RRP ${RRP}). No GP referral needed. Send an enquiry and we’ll confirm your clinic and appointment time by email.`}
  jsonLd={[orgLd, faqLd(FAQS.slice(0, 5))]}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <Image src={visit} alt="" widths={[640, 960, 1200]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker">Private blood tests across the UK and Ireland</p>
        <h1 id="hero-title">A clearer picture of your health.</h1>
        <p class="hero__lead">Private blood tests for men and women, reviewed by a clinical specialist and explained in plain English.</p>
      </div>
      <ul class="hero__facts" aria-label="At a glance">
        <li><Icon name="map-pin" />
          <strong>{COUNT} locations</strong>
          <span>Across the UK and Ireland</span></li>
        <li><Icon name="circle-check" />
          <strong>No GP referral needed</strong>
          <span>Just get in touch</span></li>
        <li><Icon name="clipboard-check" />
          <strong>Specialist-reviewed</strong>
          <span>Results in plain English</span></li>
        <li><Icon name="clock" />
          <strong>A 15-minute visit</strong>
          <span>Then back to your day</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="choose" aria-labelledby="choose-title">
    <div class="wrap">
      <div class="section__head center">
        <h2 class="display" id="choose-title">Our health checks</h2>
      </div>
      <TestCards />
    </div>
  </section>

  <Journey heading="A quick visit, then back to your day" lead="You pop in, we take a sample, and a clinical specialist looks over your results. Your report lands in your inbox, written in plain English." />

  <section class="section" aria-labelledby="included-title">
    <div class="wrap">
      <div class="section__head center">
        <h2 class="display" id="included-title">Everything is included</h2>
        <p class="lead">From the blood draw to your report, there’s nothing extra to add.</p>
      </div>
      <Tips grid compact items={INCLUDED} />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="before-title">
    <div class="wrap split">
      <div class="split__text">
        <h2 class="display" id="before-title" data-reveal>A little preparation goes a long way</h2>
        <p class="lead" data-reveal style="--d:.06s">A few simple things help your results be as accurate as they can be.</p>
        <div class="hide-sm"><Tips items={tips} /></div>
        <div class="split__foot">
          <a class="btn btn--outline" href="/how-it-works/#preparation">Read the full guide <Icon name="arrow-right" /></a>
          <p class="muted">Have a health condition, or not sure about something? Just ask us before your appointment.</p>
        </div>
      </div>
      <figure class="split__photo" data-reveal>
        <Image src={consult} alt="A doctor talking with a patient at a desk" widths={[480, 720, 960, 1200]} sizes="(min-width: 62em) 34rem, 92vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <LocationHub />

  <FaqSection items={FAQS.slice(0, 5)} more />

  <CloseEnquiry />
</Base>
