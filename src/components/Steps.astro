---
interface Props { steps: { title: string; text: string }[]; row?: boolean; level?: 'h3' | 'h4' }
const { steps, row = false, level: H = 'h3' } = Astro.props;
---
<ol class:list={['steps', { 'steps--row': row }]}>
  {steps.map((s) => (
    <li class="step">
      <span class="step__n" aria-hidden="true"></span>
      <H>{s.title}</H>
      <p>{s.text}</p>
    </li>
  ))}
</ol>
