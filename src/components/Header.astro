---
// Announcement bar + floating pill navigation. The menu expands inside the pill on small screens.
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/logo-wordmark.png';
import { NAV, SITE } from '../data/site';
const path = Astro.url.pathname;
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<div class="announce" role="region" aria-label="Announcement">
  <div class="announce__in">
    <span class="announce__spacer" aria-hidden="true"></span>
    <p>Private blood tests for men and women<span class="announce__more"> · No GP referral needed</span></p>
    <span class="announce__links"><a href="/tests/">Compare tests</a><a href="/how-it-works/">How it works</a></span>
  </div>
</div>
<header class="hdr" data-hdr>
  <div class="hdr__pill">
    <div class="hdr__bar">
      <a class="hdr__brand" href="/" aria-label={`${SITE.name} home`}>
        <Image src={wordmark} alt={SITE.name} widths={[200, 400]} sizes="12rem" loading="eager" fetchpriority="high" />
      </a>
      <nav class="hdr__nav" aria-label="Main">
        {NAV.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="hdr__actions">
        <a class="btn btn--sm hdr__enquire" href="/contact/">Enquire</a>
        <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu" data-toggle>
          <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
    <div class="hdr__panel" id="menu" data-nav>
      <div>
        <ul class="hdr__list">
          {NAV.map((n) => <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</header>
