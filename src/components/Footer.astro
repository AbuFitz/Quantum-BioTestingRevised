---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/logo-wordmark.png';
import { SITE } from '../data/site';
import { TESTS } from '../data/tests';
---
<footer class="site-footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" aria-label={`${SITE.name} home`}><Image src={wordmark} alt={SITE.name} widths={[180, 360]} sizes="11rem" loading="lazy" /></a>
      <p>{SITE.tagline}.</p>
    </div>
    <nav aria-labelledby="f-tests">
      <h2 id="f-tests">Tests</h2>
      <ul>
        <li><a href="/tests/">Compare tests</a></li>
        {TESTS.map((t) => <li><a href={`/tests/${t.slug}/`}>{t.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-labelledby="f-info">
      <h2 id="f-info">Information</h2>
      <ul>
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/contact/">Appointment enquiry</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-legal">
      <h2 id="f-legal">Legal</h2>
      <ul>
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms &amp; Conditions</a></li>
      </ul>
    </nav>
  </div>
  <div class="container footer__legal">
    <p>Quantum BioTesting health checks are private health information services. They are not a substitute for NHS services and do not constitute a diagnosis. In a medical emergency, call 999.</p>
    <p>© {new Date().getFullYear()} {SITE.legalName}. Registered in England &amp; Wales.</p>
  </div>
</footer>
