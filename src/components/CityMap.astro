---
// A schematic map of a city with the clinics as pins. Drawn here as SVG, so there is no third-party
// request, no cookie and nothing to consent to. Pin positions are approximate and the map is not to scale.
import { CLINICS, type Clinic } from '../data/clinics';
interface Props { city: 'London' | 'Birmingham'; active?: string }
const { city, active } = Astro.props;

type LL = [number, number]; // [lng, lat]
const VIEW = {
  London: { c: [-0.14, 51.508] as LL, w: 0.5, h: 0.135, k: 1930 },
  Birmingham: { c: [-1.8955, 52.4800] as LL, w: 0.03, h: 0.0135, k: 32800 },
}[city];
const cosLat = Math.cos((VIEW.c[1] * Math.PI) / 180);
const W = Math.round(VIEW.w * cosLat * VIEW.k);
const H = Math.round(VIEW.h * VIEW.k);
const px = ([lng, lat]: LL): [number, number] => [
  Math.round((W / 2 + (lng - VIEW.c[0]) * cosLat * VIEW.k) * 10) / 10,
  Math.round((H / 2 - (lat - VIEW.c[1]) * VIEW.k) * 10) / 10,
];
// Smooth a polyline into a path (Catmull-Rom to cubic Bezier)
const smooth = (pts: [number, number][]) => {
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] || pts[i], p1 = pts[i], p2 = pts[i + 1], p3 = pts[i + 2] || p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0]} ${p2[1]}`;
  }
  return d;
};
// The Thames, simplified, west to east
const THAMES: LL[] = [[-0.325, 51.452], [-0.307, 51.4612], [-0.2886, 51.4868], [-0.268, 51.4795], [-0.252, 51.4745], [-0.2297, 51.488], [-0.2128, 51.4669], [-0.1883, 51.4637], [-0.1727, 51.4825], [-0.1493, 51.485], [-0.1237, 51.487], [-0.1215, 51.5008], [-0.117, 51.5081], [-0.1045, 51.5103], [-0.0877, 51.5079], [-0.0754, 51.5055], [-0.049, 51.5085], [-0.036, 51.507], [-0.0365, 51.499], [-0.03, 51.4905], [-0.009, 51.4868], [0.0, 51.494], [-0.004, 51.5035], [0.0045, 51.5035], [0.018, 51.4985], [0.035, 51.5045], [0.06, 51.51]];
const water = city === 'London' ? smooth(THAMES.map(px)) : '';
const landmarks: { name: string; at: LL; kind: 'rail' | 'place'; dx?: number; dy?: number; anchor?: string }[] =
  city === 'London'
    ? [{ name: 'Central London', at: [-0.1276, 51.5074], kind: 'place', dx: 0, dy: 20, anchor: 'middle' }]
    : [
        { name: 'New Street', at: [-1.8985, 52.4778], kind: 'rail', dx: -8, dy: 4, anchor: 'end' },
        { name: 'Bullring', at: [-1.8929, 52.4772], kind: 'place', dx: 9, dy: 14 },
        { name: 'Cathedral', at: [-1.8999, 52.4836], kind: 'place', dx: 9, dy: 4 },
      ];
const pins = CLINICS.filter((c) => c.city === city).map((c) => ({ c, xy: px([c.lng, c.lat]) }));
const labelSide = (c: Clinic) => (c.lng > -0.05 ? 'end' : 'start');
---
<figure class="citymap" data-city={city}>
  <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={`Map of ${city} showing our clinics`}>
    <defs>
      <pattern id={`dots-${city}`} width="14" height="14" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r="1" fill="#013275" opacity="0.14" /></pattern>
    </defs>
    <rect width={W} height={H} fill="#eef3fb" />
    <rect width={W} height={H} fill={`url(#dots-${city})`} />
    {water && <path d={water} fill="none" stroke="#c9dcf5" stroke-width="15" stroke-linecap="round" stroke-linejoin="round" />}
    {water && <path d={water} fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" opacity="0.7" />}
    {city === 'London' && (() => { const [x, y] = px([-0.2105, 51.4585]); return <text x={x} y={y} class="citymap__water" transform={`rotate(-10 ${x} ${y})`}>River Thames</text>; })()}
    {city === 'Birmingham' && [45, 90, 135].map((r) => { const [x, y] = px([-1.8935, 52.4785]); return <circle cx={x} cy={y} r={r} fill="none" stroke="#013275" stroke-opacity="0.09" stroke-dasharray="3 6" />; })}
    {landmarks.map((l) => { const [x, y] = px(l.at); return (
      <g class="citymap__lm" aria-hidden="true">
        {l.kind === 'rail' ? <rect x={x - 4} y={y - 4} width="8" height="8" rx="2" fill="#fff" stroke="#4b5870" stroke-width="1.5" /> : <circle cx={x} cy={y} r="3.5" fill="#fff" stroke="#4b5870" stroke-width="1.5" />}
        <text x={x + (l.dx ?? 8)} y={y + (l.dy ?? 4)} text-anchor={l.anchor || 'start'}>{l.name}</text>
      </g>); })}
    {pins.map(({ c, xy }) => (
      <a href={`/clinics/${c.slug}/`} class:list={['citymap__pin', { 'is-active': c.slug === active, 'is-dim': active && c.slug !== active }]} aria-label={`${c.name} clinic`}>
        <g transform={`translate(${xy[0]} ${xy[1]})`}>
          <circle class="halo" r="16" />
          <path class="drop" d="M0 0 C-9 -12 -12 -17 -12 -23 A12 12 0 1 1 12 -23 C12 -17 9 -12 0 0Z" />
          <circle class="eye" cy="-23" r="4.5" />
          <text class="lab" x={labelSide(c) === 'end' ? -16 : 16} y="-18" text-anchor={labelSide(c)}>{c.name}</text>
        </g>
      </a>
    ))}
  </svg>
  <figcaption>Schematic map, not to scale. Select a pin to see the clinic.</figcaption>
</figure>
