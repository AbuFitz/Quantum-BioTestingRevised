---
import { Image } from 'astro:assets';
import BaseV2 from '../layouts/BaseV2.astro';
import Icon from '../components/Icon.astro';
import QAperture from '../components/v2/QAperture.astro';
import tube from '../assets/photos/blood-tube.jpg';
import rack from '../assets/photos/sample-rack.jpg';
import { SITE, PRICE, RRP } from '../data/site';
import { TESTS, PREPARATION, STEPS, FAQS } from '../data/tests';

const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, legalName: SITE.legalName, url: Astro.site!.href, logo: new URL('/icon-512.png', Astro.site).href };

// Short, specific descriptions for the two columns (derived from the existing approved copy)
const desc: Record<string, string> = {
  mens: 'Heart and cholesterol, blood count, metabolism, liver and kidney, thyroid, hormones, inflammation, vitamins and minerals, cancer screening markers and more, in 11 groups.',
  womens: 'Hormone balance, heart health, stress, nutrition, tumour markers and more across 27 health areas, with a GP consultation and a repeat test included.',
};
const count: Record<string, { n: string; l: string; up?: boolean }> = {
  mens: { n: '300+', l: 'biomarkers' },
  womens: { n: '350', l: 'biomarkers', up: true },
};
---
<BaseV2
  title="Private Blood Tests for Men and Women | Quantum BioTesting"
  description={`Men’s and Women’s Health Checks at ${PRICE} each. Compare the tests, then send an appointment enquiry. Results are reviewed by a clinical specialist.`}
  jsonLd={orgLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="grid hero__grid">
        <div class="hero__copy">
          <h1 class="display" id="hero-title">Private blood tests for men and women</h1>
          <p class="lead">Two health checks, each {PRICE}. Send an enquiry and the team will confirm your clinic and appointment time by email. No GP referral is needed.</p>
          <div class="hero__actions">
            <a class="btn" href="#tests">Choose your test <Icon name="arrow-right" /></a>
            <a class="link" href="/contact/">Make an enquiry</a>
          </div>
          <div class="hero__quick" aria-label="The two tests">
            {TESTS.map((t) => <a href={`#t-${t.key}`}>{t.name} <span>{PRICE}</span><Icon name="arrow-down" /></a>)}
          </div>
        </div>
        <div class="hero__art">
          <QAperture id="hero" photo={tube} alt="A gloved hand holding a test tube of blood against a white background" />
        </div>
      </div>
    </div>
  </section>

  <section class="tests on-dark" id="tests" aria-labelledby="tests-title">
    <div class="wrap">
      <div class="grid tests__head">
        <h2 class="display" id="tests-title" data-reveal>Choose your health check</h2>
        <p class="tests__price" data-reveal style="--d:.1s">{PRICE} each<span>RRP <s>{RRP}</s> per test</span></p>
      </div>
      <div class="tests__cols">
        {TESTS.map((t, i) => (
          <article class="test" aria-labelledby={`t-${t.key}`} data-reveal style={`--d:${0.1 + i * 0.12}s`}>
            <p class="test__count" aria-label={t.biomarkers}>{count[t.key].up && <small class="up" aria-hidden="true">up to</small>}<span aria-hidden="true">{count[t.key].n}</span><small aria-hidden="true">{count[t.key].l}</small></p>
            <h3 class="display" id={`t-${t.key}`}>{t.name}</h3>
            <p class="test__desc">{desc[t.key]}</p>
            <ul class="rows">
              {t.inclusions.slice(1).map((inc) => <li><Icon name={inc.icon} /><span>{inc.text}</span></li>)}
              <li><Icon name="clock" /><span>Results in {t.results}</span></li>
            </ul>
            <div class="test__buy">
              <p class="test__price"><strong>{PRICE}</strong><span>RRP <s>{RRP}</s></span></p>
            </div>
            <div class="test__actions">
              <a class="btn" href={`/contact/?test=${t.key}`}>Enquire<span class="vh"> about the {t.name}</span> <Icon name="arrow-right" /></a>
              <a class="link" href={`/tests/${t.slug}/`}>See what is tested<span class="vh"> in the {t.name}</span> <Icon name="arrow-right" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <figure class="how__img">
      <Image src={rack} alt="Blood sample tubes in a laboratory rack, a gloved hand reaching in behind" widths={[640, 960, 1280]} sizes="(min-width: 62em) 42vw, 100vw" loading="lazy" />
      <figcaption>Illustrative photograph</figcaption>
    </figure>
    <div class="how__body">
      <h2 class="display" id="how-title" data-reveal>From enquiry to report</h2>
      <p class="lead" data-reveal style="--d:.08s">Your sample is analysed in a laboratory, reviewed by a clinical specialist and returned as a digital report with plain-English commentary.</p>
      <ol class="steps">
        {STEPS.map((s, i) => (
          <li class="step" data-reveal style={`--d:${i * 0.07}s`}>
            <span class="step__n" aria-hidden="true">{i + 1}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      <p class="how__more"><a class="link" href="/how-it-works/">Everything about preparation and results <Icon name="arrow-right" /></a></p>
    </div>
  </section>

  <section class="prep" aria-labelledby="prep-title">
    <div class="wrap">
      <div class="grid prep__head">
        <h2 class="display" id="prep-title" data-reveal>Before you come in</h2>
        <p class="muted">Four things that help your results be as accurate as possible.</p>
      </div>
      <ol class="sheet">
        {PREPARATION.map((p, i) => (
          <li data-reveal style={`--d:${i * 0.06}s`}>
            <span class="n">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
      <p class="prep__note">If you take regular medication, have a health condition or are unsure about preparation, contact the team before your appointment.</p>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="grid faq__grid">
        <div class="faq__head">
          <h2 class="display" id="faq-title">Questions</h2>
          <p class="muted">Short answers to what people ask before they enquire.</p>
        </div>
        <div class="faq__list">
          {FAQS.slice(0, 5).map((f) => (
            <details>
              <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
              <div><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="close" aria-labelledby="close-title">
    <div class="close__rings" aria-hidden="true"><QAperture id="close" outline /></div>
    <div class="wrap close__inner">
      <h2 class="display" id="close-title" data-reveal>Tell us which test you would like</h2>
      <div class="close__actions" data-reveal style="--d:.1s">
        {TESTS.map((t) => <a class="btn" href={`/contact/?test=${t.key}`}>{t.name} <Icon name="arrow-right" /></a>)}
      </div>
      <p class="close__note" data-reveal style="--d:.18s">An enquiry is a request, not a confirmed booking. The team replies by email to confirm your clinic and time.</p>
    </div>
  </section>
</BaseV2>
