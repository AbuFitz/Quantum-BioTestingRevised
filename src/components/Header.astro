---
import { Image } from 'astro:assets';
import wordmark from '../assets/brand/logo-wordmark.png';
import Icon from './Icon.astro';
import { NAV, ENQUIRE_LABEL, SITE } from '../data/site';
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <Image src={wordmark} alt={SITE.name} widths={[180, 360]} sizes="(min-width: 48em) 13rem, 11rem" loading="eager" fetchpriority="high" />
    </a>
    <div class="header-actions">
      <a class="btn btn--sm" href="/contact/">{ENQUIRE_LABEL}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
        <Icon name="menu" class="icon-open" />
        <Icon name="x" class="icon-close" />
        <span>Menu</span>
      </button>
    </div>
    <nav class="site-nav" id="site-nav" aria-label="Main" data-site-nav>
      <ul class="site-nav__list">
        {NAV.map((n) => (
          <li><a class="site-nav__link" href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
