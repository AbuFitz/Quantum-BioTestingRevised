---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><Icon name="chevron-down" /></summary>
      <div><p>{f.a}</p></div>
    </details>
  ))}
</div>
