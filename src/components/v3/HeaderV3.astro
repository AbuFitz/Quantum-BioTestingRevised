---
import { Image } from 'astro:assets';
import wordmark from '../../assets/brand/logo-wordmark.png';
import Icon from '../Icon.astro';
import { NAV, SITE } from '../../data/site';
const path = Astro.url.pathname;
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="hdr" data-hdr>
  <div class="wrap hdr__bar">
    <a class="hdr__brand" href="/" aria-label={`${SITE.name} home`}>
      <Image src={wordmark} alt={SITE.name} widths={[200, 400]} sizes="(min-width: 48em) 13rem, 9.5rem" loading="eager" fetchpriority="high" />
    </a>
    <div class="hdr__actions">
      <a class="btn btn--sm" href="/contact/">Enquire</a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="nav" aria-label="Menu" data-toggle>
        <Icon name="menu" class="m" /><Icon name="x" class="x" />
      </button>
    </div>
    <nav class="hdr__nav" id="nav" aria-label="Main" data-nav>
      <ul class="hdr__list">
        {NAV.map((n) => <li><a class="hdr__link" href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>
