---
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import ClinicMap from '../../components/ClinicMap.astro';
import LocationCard from '../../components/LocationCard.astro';
import CloseEnquiry from '../../components/CloseEnquiry.astro';
import Icon from '../../components/Icon.astro';
import { CLINICS, COUNT, REGIONS, inRegion, regionSlug, placeName } from '../../data/clinics';
import { breadcrumbLd } from '../../data/seo';
const regions = REGIONS.filter((r) => inRegion(r).length);
const ld = [
  breadcrumbLd(Astro.site!, [{ name: 'Home', path: '/' }, { name: 'Locations' }]),
  { '@context': 'https://schema.org', '@type': 'ItemList', name: 'Quantum BioTesting locations', itemListElement: CLINICS.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: `Private blood tests in ${placeName(c)}`, url: new URL(`/clinics/${c.slug}/`, Astro.site).href })) },
];
---
<Base
  title={`Private Blood Test Locations Across the UK and Ireland | Quantum BioTesting`}
  description={`${COUNT} locations across England, Scotland, Wales, Northern Ireland and Ireland for the Men’s and Women’s Health Checks. Find yours and send an enquiry.`}
  jsonLd={ld}
>
  <Intro title="Find a location" lead={`${COUNT} locations across the UK and Ireland. Choose the one that suits you and we’ll confirm your time by email.`} crumbs={[{ href: '/', label: 'Home' }, { label: 'Locations' }]} />

  <section class="section section--tight" aria-labelledby="finder-title">
    <div class="wrap">
      <h2 class="vh" id="finder-title">Locations</h2>
      <div class="finder__bar">
        <div class="finder__search">
          <label class="vh" for="loc-search">Search by town, area or postcode</label>
          <Icon name="search" />
          <input id="loc-search" class="input" type="search" placeholder="Search by town, area or postcode" autocomplete="off" data-loc-search />
        </div>
        <div class="finder__chips" role="group" aria-label="Filter by region">
          <button type="button" class="chip is-on" data-region="" aria-pressed="true">All</button>
          {regions.map((r) => <button type="button" class="chip" data-region={r} aria-pressed="false">{r}</button>)}
        </div>
      </div>
      <ClinicMap tall label="Map of all our locations. Select a pin for details." />
      <p class="finder__count" data-loc-count aria-live="polite">{COUNT} locations</p>
      <p class="finder__none" data-loc-none hidden>No locations match that search. Try a town, a postcode area or a region.</p>
      {regions.map((r) => (
        <section class="finder__region" id={regionSlug(r)} data-loc-region={r} aria-labelledby={`h-${regionSlug(r)}`}>
          <h2 class="display" id={`h-${regionSlug(r)}`}>{r} <span class="finder__n">{inRegion(r).length}</span></h2>
          <ul class="locs">{inRegion(r).map((c) => <LocationCard c={c} />)}</ul>
        </section>
      ))}
    </div>
  </section>
  <CloseEnquiry />
</Base>
<script>
  const search = document.querySelector<HTMLInputElement>('[data-loc-search]')!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip[data-region]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-loc]'));
  const regions = Array.from(document.querySelectorAll<HTMLElement>('[data-loc-region]'));
  const count = document.querySelector<HTMLElement>('[data-loc-count]')!;
  const none = document.querySelector<HTMLElement>('[data-loc-none]')!;
  let region = '';
  const apply = () => {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const inR = !region || c.closest<HTMLElement>('[data-loc-region]')!.dataset.locRegion === region;
      const ok = inR && (!q || (c.dataset.search || '').includes(q));
      c.hidden = !ok; if (ok) shown++;
    });
    regions.forEach((r) => (r.hidden = !r.querySelector('[data-loc]:not([hidden])')));
    count.textContent = `${shown} location${shown === 1 ? '' : 's'}${region ? ` in ${region}` : ''}${q ? ` matching “${search.value.trim()}”` : ''}`;
    none.hidden = shown > 0;
  };
  chips.forEach((b) => b.addEventListener('click', () => {
    region = b.dataset.region || '';
    chips.forEach((x) => { const on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', String(on)); });
    document.dispatchEvent(new CustomEvent('rmap:region', { detail: { region } }));
    apply();
  }));
  search.addEventListener('input', apply);
  // Deep links such as /clinics/#scotland select that region
  const fromHash = () => { const h = decodeURIComponent(location.hash.slice(1)); const hit = chips.find((b) => (b.dataset.region || '').toLowerCase().replace(/[^a-z0-9]+/g, '-') === h); if (hit) hit.click(); };
  fromHash(); addEventListener('hashchange', fromHash);
</script>
