---
// Page head for inner pages: breadcrumbs, one h1, one lead. Sits under the floating navigation.
interface Props { title: string; lead?: string; crumbs?: { href?: string; label: string }[]; tone?: 'blush' | 'sky' | 'pink' }
const { title, lead, crumbs, tone = 'blush' } = Astro.props;
---
<div class:list={['intro', `intro--${tone}`]}>
  <div class="wrap intro__copy">
    {crumbs && (
      <nav aria-label="Breadcrumb">
        <ol class="crumbs">
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <h1 class="display">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</div>
