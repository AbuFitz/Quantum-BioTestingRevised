---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TestCards from '../components/TestCards.astro';
import Journey from '../components/Journey.astro';
import Tips from '../components/Tips.astro';
import FaqSection from '../components/FaqSection.astro';
import CloseEnquiry from '../components/CloseEnquiry.astro';
import visit from '../assets/photos/visit.jpg';
import orange from '../assets/photos/orange.jpg';
import { SITE, PRICE, RRP } from '../data/site';
import { FAQS } from '../data/tests';

const orgLd = { '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, legalName: SITE.legalName, url: Astro.site!.href, logo: new URL('/icon-512.png', Astro.site).href };
const tips = [
  { icon: 'utensils-crossed', title: 'Fast for 8–12 hours', text: 'Water is permitted and encouraged. A morning appointment is simplest for most people.' },
  { icon: 'pill', title: 'Keep taking your medication', text: 'Take prescribed medication as normal unless your doctor has advised otherwise.' },
  { icon: 'dumbbell', title: 'Skip hard exercise', text: 'Avoid intense exercise for 24 hours beforehand, as it can affect some results.' },
];
const included = [
  { icon: 'droplets', title: 'A trained phlebotomist', text: 'Your blood sample is taken at the clinic. The appointment takes about 15 minutes.' },
  { icon: 'microscope', title: 'Laboratory analysis', text: 'Your sample is analysed in the laboratory on automated platforms.' },
  { icon: 'clipboard-check', title: 'Clinical specialist review', text: 'Every result is reviewed by a clinical specialist before your report is issued.' },
  { icon: 'file-text', title: 'A plain-English report', text: 'A digital report arrives by email with commentary you can follow.' },
  { icon: 'share-2', title: 'Share it with your GP', text: 'The report can be shared with your GP or any other healthcare provider.' },
  { icon: 'stethoscope', title: 'Extras with the Women’s check', text: 'A private remote GP consultation and a 6-month repeat test are included.' },
];
---
<Base
  title="Private Blood Tests for Men and Women | Quantum BioTesting"
  description={`Men’s and Women’s Health Checks at ${PRICE} each. Choose a test, send an enquiry and the team confirms your clinic and appointment time by email.`}
  jsonLd={orgLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true">
      <Image src={visit} alt="" widths={[640, 960, 1200]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__kicker">Private blood tests in the UK</p>
        <h1 id="hero-title">Know what is going on inside, without the fuss.</h1>
        <p class="hero__lead">Choose the Men’s or Women’s Health Check, send an enquiry, and the team will confirm your clinic and appointment time by email.</p>
        <div class="hero__actions">
          <a class="btn" href="/contact/?test=mens">Men’s Health Check <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost-light" href="/contact/?test=womens">Women’s Health Check <Icon name="arrow-right" /></a>
        </div>
      </div>
      <ul class="hero__facts" aria-label="At a glance">
        <li><Icon name="pound-sterling" /><strong>{PRICE} each</strong><span>RRP {RRP}</span></li>
        <li><Icon name="clock" /><strong>15-minute visit</strong><span>At a clinic</span></li>
        <li><Icon name="circle-check" /><strong>No GP referral</strong><span>Enquire directly</span></li>
        <li><Icon name="file-text" /><strong>Specialist-reviewed</strong><span>Plain-English report</span></li>
      </ul>
      <p class="hero__note">Illustrative photograph</p>
    </div>
  </section>

  <section class="section" id="choose" aria-labelledby="choose-title">
    <div class="wrap">
      <div class="section__head center">
        <h2 class="display" id="choose-title">Choose your health check</h2>
        <p class="lead">Both tests are {PRICE}. Open a test to see everything it covers.</p>
      </div>
      <TestCards />
    </div>
  </section>

  <section class="section section--tight" aria-label="Key figures">
    <div class="wrap">
      <ul class="trio">
        <li class="feature" data-reveal><span class="feature__icon" aria-hidden="true"><Icon name="flask-conical" /></span><p class="feature__big">300+</p><p class="feature__label">Men’s Health Check</p><p>Biomarkers across 11 groups, from heart and cholesterol to hormones and vitamins.</p></li>
        <li class="feature" data-reveal style="--d:.08s"><span class="feature__icon" aria-hidden="true"><Icon name="pound-sterling" /></span><p class="feature__big">{PRICE}</p><p class="feature__label">Each test</p><p>One price for either check, against a recommended retail price of {RRP}.</p></li>
        <li class="feature" data-reveal style="--d:.16s"><span class="feature__icon" aria-hidden="true"><Icon name="flask-conical" /></span><p class="feature__big">Up to 350</p><p class="feature__label">Women’s Health Check</p><p>Biomarkers across 27 health areas, with a GP consultation and repeat test included.</p></li>
      </ul>
    </div>
  </section>

  <Journey heading="A quick visit, then back to your day" lead="Your sample goes to the laboratory, a clinical specialist reviews the results, and your report arrives by email." />

  <section class="section" aria-labelledby="included-title">
    <div class="wrap">
      <div class="section__head center">
        <h2 class="display" id="included-title">What every test includes</h2>
        <p class="lead">From the blood draw to the report, it is all in the {PRICE}.</p>
      </div>
      <Tips grid items={included} />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="before-title">
    <div class="wrap split">
      <div class="split__text">
        <h2 class="display" id="before-title" data-reveal>Before you come in</h2>
        <p class="lead" data-reveal style="--d:.06s">Three small things that help your results be as accurate as possible.</p>
        <Tips items={tips} />
        <div class="split__foot">
          <a class="btn btn--outline" href="/how-it-works/#preparation">Full preparation guide <Icon name="arrow-right" /></a>
          <p class="muted">If you have a health condition or are unsure, contact the team before your appointment.</p>
        </div>
      </div>
      <figure class="split__photo" data-reveal>
        <Image src={orange} alt="Hands cutting an orange on a wooden board" widths={[480, 720, 960]} sizes="(min-width: 62em) 34rem, 92vw" loading="lazy" />
      </figure>
    </div>
  </section>

  <FaqSection items={FAQS.slice(0, 5)} more />

  <CloseEnquiry />
</Base>
