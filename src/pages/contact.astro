---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
---
<Base
  title="Appointment Enquiry | Quantum BioTesting"
  description="Enquire about an appointment for the Men’s or Women’s Health Check. We’ll email you to confirm your clinic and time."
>
  <Intro title="Appointment enquiry" lead="Tell us which check you’d like and when suits you. We’ll reply by email to confirm. It isn’t a booking until you hear from us." crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]} />
  <section class="section">
    <div class="wrap enquiry">
      <div><EnquiryForm /></div>
      <aside class="panel" aria-labelledby="next-title">
        <h2 id="next-title">What happens next</h2>
        <ol>
          <li>We read your enquiry.</li>
          <li>We email you to confirm your clinic, date and time, or to suggest another that suits.</li>
          <li>Payment and cancellation details come with your confirmation. You can read the <a href="/terms/">Terms &amp; Conditions</a> in the meantime.</li>
        </ol>
        <p class="muted">Looking ahead? Read <a href="/how-it-works/#preparation">how to prepare</a>, see <a href="/tests/">the health checks</a> or <a href="/clinics/">find a clinic</a>.</p>
      </aside>
    </div>
  </section>
</Base>
