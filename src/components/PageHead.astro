---
interface Props { title: string; lead?: string; crumbs?: { href?: string; label: string }[] }
const { title, lead, crumbs } = Astro.props;
---
<div class="page-head">
  <div class="container">
    {crumbs && (
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol>
      </nav>
    )}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</div>
