---
// The logo's Q rebuilt as a lens: outer blue ring, inner red ring, slanted tail; the photograph
// sits inside the inner ring. Geometry measured from the supplied artwork (200-unit box).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { photo?: ImageMetadata; alt?: string; outline?: boolean; id: string }
const { photo, alt = '', outline = false, id } = Astro.props;
const TAIL = '121,115 139,115 193,172 175,172';
const blue = outline ? 1.4 : 6;
const red = outline ? 1.4 : 2.6;
---
<div class="qwrap">
<div class="q" data-q>
  {photo && (
    <div class="q__photo">
      <Image src={photo} alt={alt} widths={[420, 640, 860]} sizes="(min-width: 62em) 28rem, 22rem" loading="eager" fetchpriority="high" />
    </div>
  )}
  <svg class="q__svg" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <mask id={`cut-${id}`} maskUnits="userSpaceOnUse" x="-20" y="-20" width="240" height="240">
        <rect x="-20" y="-20" width="240" height="240" fill="#fff" />
        <polygon points={TAIL} fill="#000" stroke="#000" stroke-width="6" stroke-linejoin="miter" />
      </mask>
    </defs>
    <g mask={`url(#cut-${id})`}>
      <circle class="q__ring q__ring--blue" cx="100" cy="100" r="94" pathLength="1" fill="none" stroke="#013275" stroke-width={blue} />
      <circle class="q__ring q__ring--red" cx="100" cy="100" r="84.6" pathLength="1" fill="none" stroke="#b02018" stroke-width={red} />
    </g>
    {outline ? (
      <polygon class="q__tail" points={TAIL} fill="none" stroke="#013275" stroke-width="1.4" stroke-linejoin="miter" />
    ) : (
      <polygon class="q__tail" points={TAIL} fill="#013275" />
    )}
  </svg>
</div>
{photo && <p class="q__note">Illustrative photograph</p>}
</div>
