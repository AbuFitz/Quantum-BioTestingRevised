---
// The two tests as equal, comparable product cards. Used on the homepage and /tests/.
import Icon from './Icon.astro';
import { PRICE, RRP, SAVING } from '../data/site';
import { TESTS } from '../data/tests';
interface Props { headingLevel?: 'h2' | 'h3' }
const { headingLevel: H = 'h3' } = Astro.props;
const copy = {
  mens: { tag: 'For men', desc: 'A broad look at your heart, blood, metabolism, hormones, vitamins and more, grouped into 11 areas so it’s easy to follow.' },
  womens: { tag: 'For women', desc: 'A wide-ranging check across 27 health areas, from hormone balance and heart health to stress and nutrition, with a private GP consultation and a repeat test included.' },
};
---
<div class="cards">
  {TESTS.map((t, i) => (
    <article class:list={['card', { 'card--women': t.key === 'womens' }]} aria-labelledby={`t-${t.key}`} data-reveal style={`--d:${i * 0.1}s`}>
      <p class="card__tag">{copy[t.key].tag}</p>
      <div class="card__body">
        <H id={`t-${t.key}`}>{t.name}</H>
        <p class="card__desc">{copy[t.key].desc}</p>
        <ul class="card__meta">
          <li><Icon name="flask-conical" />{t.biomarkers}</li>
          <li><Icon name="clock" />Results in {t.results}</li>
        </ul>
        <ul class="ticks">
          {t.inclusions.slice(1).map((inc) => <li><Icon name="check" /><span>{inc.text}</span></li>)}
        </ul>
        <p class="price"><strong>{PRICE}</strong> <span class="price__rrp">RRP <s>{RRP}</s></span> <span class="price__save">Save {SAVING}</span></p>
        <div class="card__actions">
          <a class="btn" href={`/contact/?test=${t.key}`}>Enquire<span class="vh"> about the {t.name}</span> <Icon name="arrow-right" /></a>
          <a class="btn btn--outline" href={`/tests/${t.slug}/`}>What’s tested<span class="vh"> in the {t.name}</span></a>
        </div>
      </div>
    </article>
  ))}
</div>
