---
import Icon from './Icon.astro';
interface Props { items: { icon: string; title: string; text: string }[]; grid?: boolean }
const { items, grid = false } = Astro.props;
---
<ul class:list={['tips', { 'tips--grid': grid }]}>
  {items.map((t, i) => (
    <li class="tip" data-reveal style={`--d:${i * 0.08}s`}>
      <span class="tip__ic" aria-hidden="true"><Icon name={t.icon} /></span>
      <div><h3>{t.title}</h3><p>{t.text}</p></div>
    </li>
  ))}
</ul>
