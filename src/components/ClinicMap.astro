---
// A real, interactive street map (Leaflet with OpenStreetMap tiles) with every location as a pin. Pins cluster
// where they are close together. Leaflet is bundled with the site (no CDN). The map is set up when it nears the
// viewport. Without JavaScript the lists of locations on the page still work.
//
// Page scripts steer it with document events:
//   rmap:region  { region }  fit the map to a region ('' = everywhere)
//   rmap:focus   { slug }    fly to a location and open its popup
//   rmap:hover   { slug }    lift a pin while the pointer is over its list item ('' clears)
// and it announces rmap:select { slug } when a pin is chosen, so a list can follow along.
//   rmap:near    { lat, lng } show the visitor's position and fit to the nearest locations
import { CLINICS, fullAddress, subtitle, kindLabel, placeName } from '../data/clinics';
interface Props { active?: string; region?: string; size?: 'normal' | 'hub' | 'fill'; label?: string }
const { active, region, size = 'normal', label = 'Map of our locations' } = Astro.props;
const pins = CLINICS.map((c) => ({ slug: c.slug, name: placeName(c), sub: subtitle(c), kind: kindLabel(c), address: fullAddress(c), hours: c.hours ?? '', notes: c.notes ?? '', region: c.region, lat: c.lat, lng: c.lng }));
---
<div class={`rmap rmap--${size}`} data-rmap data-pins={JSON.stringify(pins)} data-active={active} data-region={region}>
  <div class="rmap__canvas" data-rmap-canvas role="group" aria-label={label}>
    <p class="rmap__wait">Loading map…</p>
  </div>
</div>
<script>
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  type Pin = { slug: string; name: string; sub: string; kind: string; address: string; hours: string; notes: string; region: string; lat: number; lng: number };
  const pinSvg = (cls: string) => `<svg class="${cls}" viewBox="0 0 32 42" width="32" height="42" aria-hidden="true"><path d="M16 41C16 41 3 26.5 3 16a13 13 0 0 1 26 0C29 26.5 16 41 16 41Z" /><circle cx="16" cy="16" r="5.2" fill="#fff" /></svg>`;
  const km = (a: [number, number], b: [number, number]) => { const R = 6371, d = Math.PI / 180, x = (b[1] - a[1]) * d * Math.cos(((a[0] + b[0]) / 2) * d), y = (b[0] - a[0]) * d; return R * Math.hypot(x, y); };

  const start = async (root: HTMLElement) => {
    const canvas = root.querySelector<HTMLElement>('[data-rmap-canvas]')!;
    const pins: Pin[] = JSON.parse(root.dataset.pins || '[]');
    const active = root.dataset.active || '';
    if (!pins.length) return;
    const L = (await import('leaflet')).default;
    await import('leaflet.markercluster');
    canvas.replaceChildren();
    const touch = L.Browser.mobile;
    // Keep the national map on the UK and Ireland rather than the whole of Europe
    const home = L.latLngBounds([49.7, -10.9], [60.0, 2.1]);
    const map = L.map(canvas, { scrollWheelZoom: false, dragging: !touch, zoomControl: true, attributionControl: true, keyboard: true, minZoom: 4, zoomSnap: 0.5, wheelDebounceTime: 30, wheelPxPerZoomLevel: 90, ...(active ? {} : { maxBounds: home.pad(0.12), maxBoundsViscosity: 0.85 }) });
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors' }).addTo(map);
    // Wheel zoom only after the visitor clicks into the map, so scrolling the page is never hijacked
    let zoomOn = false;
    canvas.addEventListener('click', () => { zoomOn = true; map.scrollWheelZoom.enable(); });
    canvas.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());
    canvas.addEventListener('mouseenter', () => { if (zoomOn) map.scrollWheelZoom.enable(); });

    const popup = (p: Pin) => {
      const box = document.createElement('div');
      box.className = 'rmap__pop';
      const k = document.createElement('span'); k.className = 'rmap__kind'; k.textContent = p.kind;
      const h = document.createElement('strong'); h.textContent = p.name;
      box.append(k, h);
      if (p.sub) { const s = document.createElement('span'); s.className = 'rmap__sub'; s.textContent = p.sub; box.append(s); }
      const a = document.createElement('p'); a.textContent = p.address; box.append(a);
      if (p.hours) { const t = document.createElement('p'); t.className = 'rmap__meta'; t.textContent = `Open ${p.hours}`; box.append(t); }
      if (p.notes) { const t = document.createElement('p'); t.className = 'rmap__meta'; t.textContent = p.notes; box.append(t); }
      const l = document.createElement('a'); l.className = 'rmap__cta'; l.href = `/clinics/${p.slug}/`; l.textContent = p.slug === active ? 'This location' : 'View location & enquire';
      box.append(l);
      return box;
    };
    const markers = new Map<string, L.Marker>();
    const mk = (p: Pin, cls = '') => {
      const icon = L.divIcon({ className: `rmap__pin ${cls}`, html: pinSvg('rmap__drop'), iconSize: [32, 42], iconAnchor: [16, 41], popupAnchor: [0, -38], tooltipAnchor: [16, -24] });
      const m = L.marker([p.lat, p.lng], { icon, title: p.name, alt: `${p.name} location`, keyboard: true, riseOnHover: true });
      m.bindTooltip(p.name, { direction: 'auto', className: 'rmap__label', permanent: cls.includes('is-active') });
      m.bindPopup(popup(p), { closeButton: true, autoPanPadding: [24, 24], maxWidth: 300, minWidth: 240, className: 'rmap__popup' });
      m.off('click', (m as any)._openPopup, m);   // a click flies to the pin first, then opens the popup (select below)
      m.on('click', () => select(p.slug));
      markers.set(p.slug, m);
      return m;
    };

    const byRegion = (r: string) => pins.filter((p) => !r || p.region === r);
    let current: Pin[] = [];
    const fit = (list: Pin[]) => {
      if (!list.length) return;
      current = list;
      if (list.length === 1) { map.setView([list[0].lat, list[0].lng], 14, { animate: !calm }); return; }
      map.fitBounds(L.latLngBounds(list.map((p) => [p.lat, p.lng] as [number, number])), { padding: [36, 36], maxZoom: 13, animate: !calm });
    };
    let cluster: any = null;
    let selected = '';
    const mark = (slug: string, cls: string, on: boolean) => { const el = markers.get(slug) && (markers.get(slug) as any)._icon as HTMLElement | undefined; el?.classList.toggle(cls, on); };
    // Fly to a location, then show its popup; the list (if any) is told which one was chosen
    const select = (slug: string) => {
      const m = markers.get(slug); if (!m) return;
      if (selected) mark(selected, 'is-selected', false);
      selected = slug;
      const ll = m.getLatLng();
      const show = () => { mark(slug, 'is-selected', true); m.openPopup(); };
      map.closePopup();
      if (cluster && !map.hasLayer(m)) { cluster.zoomToShowLayer(m, show); }
      else if (calm) { map.setView(ll, Math.max(map.getZoom(), 15), { animate: false }); show(); }
      else { map.once('moveend', show); map.flyTo(ll, Math.max(map.getZoom(), 15), { duration: 0.75, easeLinearity: 0.3 }); }
      document.dispatchEvent(new CustomEvent('rmap:select', { detail: { slug } }));
    };

    if (active) {
      const a = pins.find((p) => p.slug === active)!;
      pins.filter((p) => p.region === a.region).forEach((p) => mk(p, p.slug === active ? 'is-active' : 'is-dim').addTo(map));
      map.setView([a.lat, a.lng], 15);
    } else {
      cluster = (L as any).markerClusterGroup({ showCoverageOnHover: false, maxClusterRadius: 52, spiderfyOnMaxZoom: true,
        iconCreateFunction: (c: any) => { const n = c.getChildCount(); const s = n < 5 ? 's' : n < 15 ? 'm' : 'l'; const px = s === 's' ? 38 : s === 'm' ? 46 : 56; return L.divIcon({ html: `<span>${n}</span>`, className: `rmap__cluster rmap__cluster--${s}`, iconSize: [px, px] }); } });
      pins.forEach((p) => cluster.addLayer(mk(p)));
      map.addLayer(cluster);
      fit(byRegion(root.dataset.region || ''));
      // Fit the whole UK and Ireland snugly, and do not let people zoom out into empty sea
      requestAnimationFrame(() => { map.invalidateSize(); map.setMinZoom(Math.max(4, map.getBoundsZoom(home, false) - 0.0)); });
      document.addEventListener('rmap:region', ((e: CustomEvent) => fit(byRegion(e.detail?.region || ''))) as EventListener);
    }

    document.addEventListener('rmap:focus', ((e: CustomEvent) => select(e.detail?.slug)) as EventListener);
    document.addEventListener('rmap:hover', ((e: CustomEvent) => { markers.forEach((_, k) => mark(k, 'is-hover', false)); if (e.detail?.slug) mark(e.detail.slug, 'is-hover', true); }) as EventListener);
    map.on('popupclose', () => { if (selected) { mark(selected, 'is-selected', false); selected = ''; } });

    // "Show all locations" returns to the starting view once the visitor has zoomed in
    if (!active) {
      let btn: HTMLButtonElement;
      const Reset = (L.Control as any).extend({ onAdd() { btn = L.DomUtil.create('button', 'rmap__reset') as HTMLButtonElement; btn.type = 'button'; btn.textContent = 'Show all locations'; btn.hidden = true; L.DomEvent.disableClickPropagation(btn); btn.addEventListener('click', () => { map.closePopup(); fit(current); }); return btn; } });
      new Reset({ position: 'bottomleft' }).addTo(map);
      const base = () => map.getBoundsZoom(L.latLngBounds(current.map((p) => [p.lat, p.lng] as [number, number])).pad(0.1), false);
      map.on('zoomend moveend', () => { btn.hidden = map.getZoom() < base() + 1.5; });
    }

    let you: L.Marker | null = null;
    document.addEventListener('rmap:near', ((e: CustomEvent) => {
      const { lat, lng } = e.detail; you?.remove();
      you = L.marker([lat, lng], { icon: L.divIcon({ className: 'rmap__you', html: '<span></span>', iconSize: [18, 18] }), interactive: false, keyboard: false }).addTo(map);
      const near = [...pins].sort((a, b) => km([lat, lng], [a.lat, a.lng]) - km([lat, lng], [b.lat, b.lng])).slice(0, 3);
      map.fitBounds(L.latLngBounds([[lat, lng], ...near.map((p) => [p.lat, p.lng] as [number, number])]), { padding: [48, 48], maxZoom: 13 });
    }) as EventListener);

    requestAnimationFrame(() => map.invalidateSize());
    new ResizeObserver(() => map.invalidateSize()).observe(canvas);
  };

  const roots = document.querySelectorAll<HTMLElement>('[data-rmap]');
  const io = 'IntersectionObserver' in window ? new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { io!.unobserve(e.target); start(e.target as HTMLElement); } }), { rootMargin: '300px 0px' }) : null;
  roots.forEach((r) => (io ? io.observe(r) : start(r)));
</script>
