---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EnquiryDialog from '../components/EnquiryDialog.astro';
import fraunces from '../assets/fonts/fraunces-subset.woff2?url';
import jakarta from '../assets/fonts/jakarta-subset.woff2?url';
import { SITE } from '../data/site';

interface Props { title: string; description: string; jsonLd?: object | object[] }
const { title, description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og-image.png', Astro.site).href;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jakarta} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    {Astro.url.pathname !== '/contact/' && <EnquiryDialog />}
    <script>
      // Floating navigation: the menu expands inside the pill on small screens; Escape closes and returns focus.
      const toggle = document.querySelector<HTMLButtonElement>('[data-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      if (toggle && nav) {
        const mq = window.matchMedia('(min-width: 62em)');
        const set = (open: boolean, restore = false) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          nav.classList.toggle('is-open', open);
          nav.toggleAttribute('inert', !open);
          if (!open && restore) toggle.focus();
        };
        set(false);
        toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') set(false, true); });
        nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
        mq.addEventListener('change', () => set(false));
      }
      // Quiet entrance for chapters; everything is visible without JS or with reduced motion.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (items.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
        items.forEach((i) => io.observe(i));
        setTimeout(() => items.forEach((i) => i.classList.add('is-in')), 4000);
      } else items.forEach((i) => i.classList.add('is-in'));
    </script>
  </body>
</html>
