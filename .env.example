# Enquiry delivery (server-side only; never prefix with PUBLIC_).
# Without all three values /api/enquiry answers 503 and the form shows a failure state.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# Optional: canonical origin used for canonical URLs, sitemap and social tags.
# Defaults to https://quantum-bio-testing.vercel.app (the only confirmed deployment).
PUBLIC_SITE_URL=
