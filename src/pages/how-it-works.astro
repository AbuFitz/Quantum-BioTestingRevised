---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import VisitChapter from '../components/VisitChapter.astro';
import Tips from '../components/Tips.astro';
import FaqSection from '../components/FaqSection.astro';
import CloseEnquiry from '../components/CloseEnquiry.astro';
import Icon from '../components/Icon.astro';
import results from '../assets/photos/results.jpg';
import { PREPARATION, CLINICS, FAQS } from '../data/tests';
---
<Base
  title="How It Works: Appointment, Preparation and Results | Quantum BioTesting"
  description="How an enquiry becomes an appointment, how to prepare for your blood test, what happens at the clinic and when results arrive."
>
  <Intro title="How it works" lead="From enquiry to report, and what to do before your appointment." crumbs={[{ href: '/', label: 'Home' }, { label: 'How it works' }]} />

  <VisitChapter id="process-title" heading="The process" lead="Sending the enquiry form does not confirm a booking. Your appointment is confirmed when the team emails you the clinic and time." more={false} photo={false} />

  <section class="section" id="preparation" aria-labelledby="prep-title">
    <div class="wrap">
      <div class="section__head">
        <h2 class="display" id="prep-title">Preparing for your test</h2>
        <p class="muted">Following these guidelines helps your results be as accurate as possible.</p>
      </div>
      <Tips grid items={PREPARATION.map((p) => ({ icon: p.icon, title: p.title, text: p.text }))} />
      <p class="note" style="margin-top:1.75rem">If you take regular medication, have a health condition or are unsure about preparation, please contact the team before your appointment.</p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="clinic-title">
    <div class="wrap split">
      <div>
        <div class="section__head">
          <h2 class="display" id="clinic-title">At the clinic</h2>
          <p class="muted">The appointment takes about 15 minutes. A trained phlebotomist takes your blood sample. Wear a short-sleeved or loose-fitting top.</p>
        </div>
        <h3 class="display" style="font-size:1.4rem">Clinic locations</h3>
        <ul class="clinics">
          {CLINICS.map((c) => <li class="clinic"><Icon name="map-pin" /><div><strong>{c.name}</strong><span>{c.address}</span></div></li>)}
        </ul>
        <p class="muted" style="margin-top:1rem;max-width:36rem">Tell us your preferred clinic or area when you enquire. The team confirms the location with you by email.</p>
      </div>
      <figure class="photo">
        <Image src={results} alt="A clinician explaining test results to a colleague at a computer" widths={[480, 720, 960]} sizes="(min-width: 62em) 30rem, 92vw" loading="lazy" />
        <figcaption>Illustrative photograph</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="results-title">
    <div class="wrap"><div class="prose">
      <h2 class="display" id="results-title">Your results</h2>
      <p>Your sample is analysed in the laboratory and every result is reviewed by a clinical specialist. The digital report arrives by email with plain-English commentary on your results.</p>
      <p>Standard results take 2–5 working days from sample receipt at the laboratory, and 4 working days for the Women’s Health Check. An express service may return results in as little as 2 hours; ask the team about availability when you enquire.</p>
      <p>Your report can be shared with your GP or any other healthcare provider.</p>
    </div>
    </div>
  </section>

  <FaqSection id="faq-title" heading="Questions" items={FAQS} />
  <CloseEnquiry />
</Base>
