---
import Base from '../../layouts/Base.astro';
import Intro from '../../components/Intro.astro';
import TestCards from '../../components/TestCards.astro';
import CloseEnquiry from '../../components/CloseEnquiry.astro';
import { INCLUDED, MENU_NOTE } from '../../data/tests';
import Tips from '../../components/Tips.astro';
import { PRICE, RRP } from '../../data/site';
import { breadcrumbLd } from '../../data/seo';
---
<Base
  title="Men’s and Women’s Health Checks | Quantum BioTesting"
  description={`Explore the Men’s Health Check (300+ biomarkers) and the Women’s Health Check (up to 350 biomarkers). ${PRICE} each, RRP ${RRP}.`}
  jsonLd={breadcrumbLd(Astro.site!, [{ name: 'Home', path: '/' }, { name: 'Tests' }])}
>
  <Intro title="Our health checks" lead="Two health checks, each built around you. Open one to see everything it covers." crumbs={[{ href: '/', label: 'Home' }, { label: 'Tests' }]} />

  <section class="section" aria-labelledby="choose-title">
    <div class="wrap">
      <h2 id="choose-title" class="vh">The two tests</h2>
      <TestCards headingLevel="h3" />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="inc-title">
    <div class="wrap">
      <div class="section__head center">
        <h2 class="display" id="inc-title">Included with both checks</h2>
        <p class="lead">From the blood draw to your report, there’s nothing extra to add.</p>
      </div>
      <Tips grid compact items={INCLUDED} />
      <p class="muted center" style="margin-top:1.5rem;max-width:40rem">{MENU_NOTE}</p>
    </div>
  </section>
  <CloseEnquiry />
</Base>
